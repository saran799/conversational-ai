# Application Settings
PROJECT_NAME="Chennai Mobility AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma separated or JSON string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL)
# Note: For initial local testing, database is optional (standalone/SQLite fallback supported)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chennai_mobility
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chennai_mobility

# Worker 1: Voice AI & Telephony (Exotel & Sarvam AI)
SARVAM_API_KEY=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=
TRANSIT_LAPTOP_IP=192.168.137.171
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Worker 2: Mobility Backend
GTFS_DATA_DIR=data/fixtures

# Worker 3: Messaging & Complaints (WhatsApp & SMS)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_API_KEY=

